{
  "name": "microlearning-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Microlearning Classroom LMS Platform",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @microlearning/web",
    "dev:api": "npm run dev --workspace @microlearning/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "identity:verify": "node scripts/verify-gcp-identity.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:openapi": "npm run test:openapi --workspace @microlearning/api",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line,html",
    "test:e2e:cloud": "playwright test --config playwright.cloud.config.ts",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "reporting:rebuild": "npm run reporting:rebuild --workspace @microlearning/api --",
    "reporting:reconcile": "npm run reporting:reconcile --workspace @microlearning/api --",
    "reporting:benchmark": "npm run reporting:benchmark --workspace @microlearning/api --",
    "audit:production": "node scripts/audit-production.mjs",
    "build:production": "node scripts/build-production.mjs",
    "container:build": "node scripts/build-production-image.mjs",
    "container:scan": "node scripts/scan-production-image.mjs",
    "container:verify": "node scripts/verify-production-image.mjs",
    "release-manifest:local": "node scripts/generate-release-manifest.mjs",
    "release-manifest:validate": "node scripts/validate-release-manifest.mjs",
    "release:contract:test": "node scripts/test-release-contract.mjs && node scripts/test-cd-contract.mjs",
    "release:lineage:validate": "node scripts/validate-release-lineage.mjs",
    "deployment-record:create": "node scripts/create-deployment-record.mjs",
    "deployment-record:validate": "node scripts/validate-deployment-record.mjs",
    "deployment-record:promote": "node scripts/promote-stable-deployment.mjs",
    "rollback-record:validate": "node scripts/validate-rollback-record.mjs",
    "rollback:verify": "node scripts/verify-rollback-recovery.mjs",
    "operations:contract:test": "node scripts/test-recovery-contract.mjs",
    "observability:contract:test": "node scripts/test-observability-contract.mjs",
    "promotion:contract:test": "node scripts/test-promotion-contract.mjs",
    "hardening:contract:test": "node scripts/test-hardening-contract.mjs",
    "exit:contract:test": "node scripts/test-exit-contract.mjs",
    "handoff:contract:test": "node scripts/test-handoff-contract.mjs",
    "cloud:security:verify": "node scripts/verify-cloud-security.mjs",
    "e2e:artifacts:scan": "node scripts/scan-e2e-artifacts.mjs",
    "sbom:production": "node scripts/generate-production-sbom.mjs",
    "terraform:fmt": "terraform fmt -recursive infrastructure/terraform",
    "terraform:fmt:check": "terraform fmt -check -recursive infrastructure/terraform",
    "terraform:plan:check": "node scripts/check-terraform-plan.mjs",
    "terraform:policy:test": "node scripts/test-terraform-policy.mjs",
    "terraform:security": "node scripts/scan-terraform-config.mjs",
    "terraform:validate": "node scripts/validate-terraform.mjs",
    "terraform:check": "npm run terraform:validate",
    "verify:runtime-config": "node scripts/verify-runtime-config-contract.mjs",
    "verify:staging": "node scripts/verify-staging-deployment.mjs",
    "verify:web-bundle": "node scripts/verify-web-bundle.mjs",
    "verify:negative-gate": "node scripts/verify-negative-lint-gate.mjs",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run verify:negative-gate && npm run format:check && npm run typecheck && npm run test && npm run operations:contract:test && npm run observability:contract:test && npm run promotion:contract:test && npm run hardening:contract:test && npm run exit:contract:test && npm run handoff:contract:test && npm run build",
    "check:ci": "npm run lint && npm run verify:negative-gate && npm run format:check && npm run typecheck && npm run test:coverage && npm run operations:contract:test && npm run observability:contract:test && npm run promotion:contract:test && npm run hardening:contract:test && npm run exit:contract:test && npm run handoff:contract:test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "shell-quote": "1.10.0",
    "undici": "7.29.0"
  }
}
