{
  "name": "microlearning-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Microlearning Classroom LMS Platform",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @microlearning/web",
    "dev:api": "npm run dev --workspace @microlearning/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:openapi": "npm run test:openapi --workspace @microlearning/api",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line,html",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "reporting:rebuild": "npm run reporting:rebuild --workspace @microlearning/api --",
    "reporting:reconcile": "npm run reporting:reconcile --workspace @microlearning/api --",
    "reporting:benchmark": "npm run reporting:benchmark --workspace @microlearning/api --",
    "audit:production": "node scripts/audit-production.mjs",
    "verify:negative-gate": "node scripts/verify-negative-lint-gate.mjs",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run verify:negative-gate && npm run format:check && npm run typecheck && npm run test && npm run build",
    "check:ci": "npm run lint && npm run verify:negative-gate && npm run format:check && npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "shell-quote": "1.10.0",
    "undici": "7.29.0"
  }
}
